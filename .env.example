# Environment Variables for Vercel Deployment (Group 4 Enquiry Forwarding)
# DO NOT COMMIT REAL SECRETS OR SHEET IDENTIFIERS
# When left unset, the application automatically runs in explicit Demo Mode.

# Google Apps Script Web App Deployment URL (configured by Benjamin)
APPS_SCRIPT_URL=

# Shared Secret Token for API Authentication between Vercel Serverless and Apps Script
ENQUIRY_SECRET=

# Optional Google Sheet ID for verification/admin audit
GOOGLE_SHEET_ID=
